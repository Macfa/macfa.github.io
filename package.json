{
  "name": "macfa-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run content:sync && next dev",
    "build": "npm run content:sync && next build --webpack && node -e \"require('fs').writeFileSync('out/.nojekyll','')\"",
    "content:sync": "node scripts/sync-content.mjs",
    "content:check": "node scripts/sync-content.mjs",
    "db:seed": "npm run content:sync",
    "start": "next start",
    "lint": "eslint"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.3.7",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
